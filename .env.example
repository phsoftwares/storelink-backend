# Copy these values into the API process environment. Replace every placeholder.
DATABASE_URL=postgres://storelink:replace-me@127.0.0.1:5432/storelink?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8080
ALLOWED_ORIGIN=http://127.0.0.1:5173
SWAGGER_ENABLED=true

# Required only on the first startup, when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=StoreLink Administrator
ADMIN_PASSWORD=replace-with-a-strong-password-of-12-to-72-characters

MESSAGE_LEASE=60s
AGENT_OFFLINE_AFTER=90s
REQUEST_TIMEOUT=30s
MAX_ATTEMPTS=5
RETRY_DELAYS=5s,30s,2m,10m
SYNC_BATCH_SIZE=500
